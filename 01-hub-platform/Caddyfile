# NEXUS404 — Caddy: обратный прокси перед хабом + HTTPS
#
# Staging CA убран — мы ни разу не выпускали боевой сертификат за весь
# проект (только staging, специально ради отладки без риска упереться в
# лимит перевыпусков), так что первый боевой выпуск здесь безопасен.
# Причина, по которой это важно сейчас: недоверенный сертификат не даёт
# Chrome полноценно установить PWA (падает обратно на простой ярлык) —
# для этого нужен именно доверенный HTTPS, не просто HTTPS как таковой.

# Домен подставляется автоматически при установке (install-hub-platform.sh
# спрашивает его в терминале) — руками ничего менять не нужно
your-domain.example.com {
	# Временная защита (basic_auth) убрана — страница входа хаба (раздел 2
	# плана) доказала, что реально работает: полный цикл проверен вживую
	# (без сессии -> редирект на /login -> неверный пароль -> 401 -> верный
	# пароль -> сессия -> доступ есть -> без сессии снова закрыто).
	# basic_auth и это самое место в файле — на случай, если понадобится
	# снова временно закрыть домен ещё одним слоем при последующих правках.

	# /health и всё остальное пока идёт напрямую в хаб — по мере появления
	# модулей сюда добавятся отдельные path-based или поддоменные маршруты
	# (карточка/окно модуля рисует сам хаб, см. план раздела 1)
	reverse_proxy hub:3000

	encode gzip

	log {
		output file /data/access.log {
			roll_size 10mb
			roll_keep 5
		}
	}
}
